{
  "name": "helthtw",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "ready": "vp check && secretlint \"**/*\" && vp test --passWithNoTests && vp run -r build",
    "dev": "vp run -r --parallel dev"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "catalog:",
    "secretlint": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
