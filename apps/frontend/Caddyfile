# Serves the built frontend over HTTPS and forwards API calls to the backend container.
{
	# No admin API and no saved config: the container is replaced on every deploy.
	admin off
	persist_config off
	# The certificate comes from HTW (compose.yml mounts it), Caddy doesn't fetch its own or redirect by itself.
	auto_https off
	# The container can't reach the internet, so it can't fetch OCSP answers from the CA.
	ocsp_stapling off
	# No HTTP/3: it needs UDP 443, which isn't published.
	servers {
		protocols h1 h2
	}
}

# Unprivileged ports, compose maps them to 80 and 443 on the VM.
:8080 {
	# The health check in compose.yml comes from inside the container and doesn't know the certificate's name.
	@inside remote_ip 127.0.0.1 ::1
	handle @inside {
		respond 200
	}

	handle {
		redir https://{host}{uri} permanent
	}
}

https://:8443 {
	tls /certs/fullchain.pem /certs/key.pem
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:3000
	}

	# File names in assets/ contain a content hash, so they never change.
	# A missing one stays a 404: after a deploy, an open tab may still ask for an old chunk.
	handle /assets/* {
		root * /srv
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		# index.html names the current assets, so the browser has to check it on every load.
		header Cache-Control "no-cache"
		# Unknown paths are client-side routes (TanStack Router), so they get index.html.
		try_files {path} /index.html
		file_server
	}
}
