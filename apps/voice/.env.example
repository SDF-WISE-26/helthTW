# LiveKit (LiveKit Cloud project or a local livekit-server)
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ElevenLabs: speech to text and text to speech
ELEVEN_API_KEY=

# LLM for the first test (the only non-ElevenLabs service)
GOOGLE_API_KEY=

# Optional: pick other implementations from src/providers (defaults shown)
# STT_PROVIDER=elevenlabs
# LLM_PROVIDER=gemini
# TTS_PROVIDER=elevenlabs
