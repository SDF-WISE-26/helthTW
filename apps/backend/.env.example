DATABASE_URL=postgres://helthtw:helthtw@localhost:5432/helthtw

LLM_BASE_URL=https://example-base-url.com
LLM_API_KEY=example-api-key
LLM_MODEL=example-model
# Optional faster model for voice, falls back to LLM_MODEL
# VOICE_LLM_MODEL=example-small-model

# Guard in the gateway between user, LLM and output (docs/decisions/2026-11-13-guard-gateway.md)
# GUARD_PROVIDER=passthrough

# Voice (docs/specs/voice.md). Without LiveKit, POST /api/v1/voice/sessions answers 503.
# LiveKit Cloud: URL and keys of the project. Self-hosted: `docker compose --profile livekit up -d`, then
# LIVEKIT_URL=ws://localhost:7880, LIVEKIT_API_KEY=devkey, LIVEKIT_API_SECRET=secret
# LIVEKIT_URL=wss://example-project.livekit.cloud
# LIVEKIT_API_KEY=example-livekit-key
# LIVEKIT_API_SECRET=example-livekit-secret
# Only the voice worker (vp run backend#dev:voice) needs these
# ELEVENLABS_API_KEY=example-elevenlabs-key
# VOICE_STT_PROVIDER=elevenlabs
# VOICE_STT_LANGUAGE=de
# VOICE_TTS_PROVIDER=elevenlabs
# VOICE_TTS_VOICE_ID=ZYxkHelwVfZIJ3DA24gN
# VOICE_TTS_MODEL=eleven_flash_v2_5
