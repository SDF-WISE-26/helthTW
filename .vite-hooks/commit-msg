#!/bin/sh
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)\([a-z0-9-]+\)!?: .+'
if ! head -n1 "$1" | grep -Eq "$pattern" && ! head -n1 "$1" | grep -Eq '^(Merge|Revert) '; then
  echo "Die Commit-Nachricht soll dem Conventional-Commits-Standard entsprechen. Bitte passe sie so an (z. B.): '<typ>(<bereich>): <beschreibung>'"
  echo "Mögliche Typen sind: feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"
  exit 1
fi
